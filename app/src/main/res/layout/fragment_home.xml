<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/healthLightGray"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <!-- Welcome Message -->
        <TextView
            android:id="@+id/welcomeMessageTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:text="Welcome !"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <!-- Daily Tips or Insights Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dailyTipsCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:background="@color/healthWhite"
            app:cardCornerRadius="@dimen/_12sdp">

            <LinearLayout
                android:id="@+id/dailyTipsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:id="@+id/dailyTipsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:text="Daily Tips and Insights"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dailyTipText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14ssp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Appointments Section -->
        <TextView
            android:id="@+id/appointmentsTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Appointments"
            android:textColor="@color/healthDarkBlue"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appointmentsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp" />

        <!-- Health Goals Section -->
        <TextView
            android:id="@+id/healthGoalsTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Health Goals"
            android:textColor="@color/healthDarkBlue"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/healthLightBlue"
            android:orientation="vertical"
            android:padding="@dimen/_8sdp">

            <CheckBox
                android:id="@+id/goal1Checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exercise 30 minutes daily"
                android:textColor="@color/healthDarkGray" />

            <CheckBox
                android:id="@+id/goal2Checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eat 5 servings of fruits and vegetables daily"
                android:textColor="@color/healthDarkGray" />

            <CheckBox
                android:id="@+id/goal3Checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drink 8 glasses of water daily"
                android:textColor="@color/healthDarkGray" />

            <!-- Add more checkboxes for additional goals as needed -->

        </LinearLayout>

        <!-- Emergency Contact Information -->
        <TextView
            android:id="@+id/emergencyContactTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Emergency Contact Information"
            android:textColor="@color/healthDarkBlue"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emergencyContactEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:hint="Emergency Contact Number"
            android:inputType="phone" />

        <!-- Feedback and Support -->
        <TextView
            android:id="@+id/feedbackSupportTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Feedback and Support"
            android:textColor="@color/healthDarkBlue"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/feedbackEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:hint="Enter your feedback here" />

        <Button
            android:id="@+id/submitFeedbackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit Feedback" />

    </LinearLayout>
</ScrollView>
