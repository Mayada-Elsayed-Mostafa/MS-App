<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp"
    tools:context=".CisActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:text="CIS Test for MS"
        android:textColor="@color/darkHealthBlue"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold" />


    <com.balysv.materialripple.MaterialRippleLayout
        style="@style/Ripple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:elevation="@dimen/_4sdp"
        app:mrl_rippleRoundedCorners="@dimen/_18sdp">

        <Button
            android:id="@+id/upload_file_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/outlined_button_background"
            android:text="Upload File"
            android:textColor="@color/darkHealthBlue"
            android:textSize="@dimen/_14ssp" />

    </com.balysv.materialripple.MaterialRippleLayout>

    <com.balysv.materialripple.MaterialRippleLayout
        style="@style/Ripple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:elevation="@dimen/_4sdp"
        app:mrl_rippleRoundedCorners="@dimen/_18sdp">

        <Button
            android:id="@+id/start_test_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/outlined_button_background"
            android:text="Start Test"
            android:textColor="@color/darkHealthBlue"
            android:textSize="@dimen/_14ssp" />
    </com.balysv.materialripple.MaterialRippleLayout>


</LinearLayout>